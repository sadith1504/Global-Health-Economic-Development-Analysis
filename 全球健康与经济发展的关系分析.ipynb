    "# 复制所需列并清洗\n",
    "df_eff = data[[country_col, life_col, health_col]].copy()\n",
    "for col in [life_col, health_col]:\n",
    "    df_eff[col] = df_eff[col].astype(str).str.replace(',', '').str.replace('%', '')\n",
    "    df_eff[col] = pd.to_numeric(df_eff[col], errors='coerce')\n",
    "\n",
    "# 删除缺失与无效值\n",
    "df_eff = df_eff.dropna(subset=[life_col, health_col])\n",
    "df_eff = df_eff[df_eff[health_col] > 0]\n",
    "\n",
    "# 计算效率指标并取国家平均\n",
    "df_eff['效率比'] = df_eff[life_col] / df_eff[health_col]\n",
    "df_avg = df_eff.groupby(country_col, as_index=False)['效率比'].mean()\n",
    "\n",
    "# 取前10国家\n",
    "top10 = df_avg.sort_values('效率比', ascending=False).head(10).iloc[::-1]\n",
    "\n",
    "# 绘图\n",
    "plt.figure(figsize=(10,6))\n",
    "sns.barplot(y=country_col, x='效率比', data=top10, palette='Blues_r')\n",
    "plt.title('医疗支出效率最高的10个国家')\n",
