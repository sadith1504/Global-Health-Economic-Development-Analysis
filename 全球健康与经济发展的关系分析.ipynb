    "if {'Country', 'Year', life_col, health_col}.issubset(data.columns):\n",
    "    # 计算各国寿命增长率\n",
    "    df_growth = data.sort_values(['Country', 'Year']).copy()\n",
    "    df_growth['寿命增长率'] = df_growth.groupby('Country')[life_col].pct_change() * 100\n",
    "    df_growth = df_growth.dropna(subset=['寿命增长率', health_col])\n",
    "    \n",
    "    # 计算每个国家的平均增长率和平均支出\n",
    "    df_mean = df_growth.groupby('Country', as_index=False)[['寿命增长率', health_col]].mean()\n",
    "    \n",
    "    # 绘图：支出 vs 增长率\n",
    "    plt.figure(figsize=(8,6))\n",
    "    sns.regplot(x=health_col, y='寿命增长率', data=df_mean, scatter_kws={'alpha':0.6})\n",
    "    plt.title(\"医疗支出 与 平均寿命增长率 的关系\")\n",
    "    plt.xlabel(\"医疗支出（占GDP %）\")\n",
    "    plt.ylabel(\"平均寿命增长率（%）\")\n",
    "    plt.show()\n",
    "    \n",
    "    corr_val = df_mean[[health_col, '寿命增长率']].corr().iloc[0,1]\n",
    "    print(f\"Pearson 相关系数：{corr_val:.3f}\")\n",
    "else:\n",
    "    print(\"提示：数据中缺少必要列（Country、Year、Life expectancy 或 Health expenditure），请确认列名。\")"
